# ============================================================================
# Xevyte Connect HRMS Agent — environment configuration
# Copy to .env and fill in. Nothing here is a real secret; values below are
# either safe defaults, staging URLs already public in the Xevyte Connect
# repo's own .env, or placeholders you must fill in yourself.
# ============================================================================

# ---- Xevyte Connect HRMS backend (employee-login-backend2) ----
# Point this at wherever that Spring Boot app is actually running.
HRMS_API_BASE_URL=http://localhost:8082

# ---- Scaloz IAM SSO (same login the React frontend uses) ----
SCALOZ_IAM_URL=https://workspacetest.scaloz.com
# Public URL of THIS agent (used as the SSO redirect_to target — see
# app/auth/sso.py for why this may need a one-time check with whoever
# administers Scaloz IAM).
AGENT_PUBLIC_URL=https://localhost:8443

# ---- LLM provider (OpenAI by default; swap via OPENAI_BASE_URL for a
# LiteLLM proxy / OpenRouter / Azure OpenAI / any OpenAI-compatible host) ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
CHAT_MODEL=gpt-4o-mini
PLANNER_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER_API_KEY=

# ---- LangSmith tracing (optional) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=xevyte-agent

# ---- Postgres ----
DATABASE_URL=postgresql+psycopg2://xevyte_agent:xevyte_agent@localhost:5432/xevyte_agent

# ---- Chroma (local persistent vector store, no external service needed) ----
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=xevyte_endpoints
RAG_TOP_K=12

# ---- Catalog (regenerate with scripts/parse_java_endpoints.py) ----
ENDPOINT_CATALOG_PATH=app/catalog/endpoint_catalog.json
OPENAPI_CATALOG_PATH=app/catalog/openapi_catalog.json

# ---- Live catalog auto-refresh ----
# Set JAVA_SOURCE_DIR + AUTO_WATCH_JAVA_SOURCE=true if this agent process
# can see the Java source on disk (same host, or a mounted volume) and you
# want new endpoints picked up automatically as the backend evolves.
# Leave AUTO_WATCH_JAVA_SOURCE=false (default) to refresh manually or via
# CI/CD instead — see README "Re-run when the Java backend changes".
JAVA_SOURCE_DIR=
AUTO_WATCH_JAVA_SOURCE=false
JAVA_SOURCE_WATCH_DEBOUNCE_SECONDS=4

# ---- Session encryption ----
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# This is NOT the HRMS backend's JWT_SECRET — it only encrypts this agent's
# own local copy of a token Scaloz IAM already issued. Keep it out of git.
SESSION_SECRET_KEY=
SESSION_COOKIE_NAME=xevyte_agent_session
SESSION_TTL_HOURS=12

# ---- Guardrails ----
# LOW | MEDIUM | HIGH | CRITICAL — calls at or above this tier are shown to
# the user for explicit approval before executing.
REQUIRE_CONFIRMATION_ABOVE_RISK=MEDIUM

# ---- HTTPS ----
# Local dev: generate with certs/generate_self_signed.sh, point these at it.
# Production: leave blank and terminate TLS at a reverse proxy instead.
SSL_KEYFILE=
SSL_CERTFILE=
SERVER_HOST=0.0.0.0
SERVER_PORT=8443

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
